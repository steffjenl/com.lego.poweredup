{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.lego.poweredup",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Lego Powered UP"
  },
  "description": {
    "en": "Powered UP, powered by Homey."
  },
  "brandColor": "#D01012",
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Stèphan Eizinga",
    "email": "stephan@monkeysoft.nl"
  },
  "flow": {
    "triggers": [
      {
        "id": "hub_connected",
        "title": {
          "en": "Hub connected",
          "nl": "Hub verbonden"
        },
        "hint": {
          "en": "Triggers when the hub's Bluetooth connection is (re)established.",
          "nl": "Wordt geactiveerd zodra de Bluetooth-verbinding met de hub (opnieuw) tot stand komt."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          }
        ]
      },
      {
        "id": "hub_disconnected",
        "title": {
          "en": "Hub disconnected",
          "nl": "Hub niet meer verbonden"
        },
        "hint": {
          "en": "Triggers when the hub's Bluetooth connection is lost.",
          "nl": "Wordt geactiveerd zodra de Bluetooth-verbinding met de hub wegvalt."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "hub_is_connected",
        "title": {
          "en": "Hub !{{is|isn't}} connected",
          "nl": "Hub !{{is|is niet}} verbonden"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_power",
        "title": {
          "en": "Set power",
          "nl": "Stel vermogen in"
        },
        "titleFormatted": {
          "en": "Set power on port [[port]] to [[power]]%",
          "nl": "Stel vermogen op poort [[port]] in op [[power]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          },
          {
            "type": "dropdown",
            "name": "port",
            "title": {
              "en": "Port",
              "nl": "Poort"
            },
            "values": [
              {
                "id": "a",
                "title": {
                  "en": "A",
                  "nl": "A"
                }
              },
              {
                "id": "b",
                "title": {
                  "en": "B",
                  "nl": "B"
                }
              }
            ]
          },
          {
            "type": "range",
            "name": "power",
            "title": {
              "en": "Power",
              "nl": "Vermogen"
            },
            "min": -100,
            "max": 100,
            "step": 1,
            "label": "%"
          }
        ]
      },
      {
        "id": "run_for_duration",
        "title": {
          "en": "Run for a duration",
          "nl": "Laat rijden voor een bepaalde tijd"
        },
        "titleFormatted": {
          "en": "Run port [[port]] at [[power]]% for [[duration]] seconds, then brake",
          "nl": "Laat poort [[port]] [[duration]] seconden op [[power]]% draaien en rem daarna af"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          },
          {
            "type": "dropdown",
            "name": "port",
            "title": {
              "en": "Port",
              "nl": "Poort"
            },
            "values": [
              {
                "id": "a",
                "title": {
                  "en": "A",
                  "nl": "A"
                }
              },
              {
                "id": "b",
                "title": {
                  "en": "B",
                  "nl": "B"
                }
              }
            ]
          },
          {
            "type": "range",
            "name": "power",
            "title": {
              "en": "Power",
              "nl": "Vermogen"
            },
            "min": -100,
            "max": 100,
            "step": 1,
            "label": "%"
          },
          {
            "type": "number",
            "name": "duration",
            "title": {
              "en": "Duration (seconds)",
              "nl": "Duur (seconden)"
            },
            "min": 1,
            "max": 3600,
            "step": 1
          }
        ]
      },
      {
        "id": "brake",
        "title": {
          "en": "Brake",
          "nl": "Afremmen"
        },
        "titleFormatted": {
          "en": "Brake port [[port]]",
          "nl": "Rem poort [[port]] af"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=poweredup-hub"
          },
          {
            "type": "dropdown",
            "name": "port",
            "title": {
              "en": "Port",
              "nl": "Poort"
            },
            "values": [
              {
                "id": "a",
                "title": {
                  "en": "A",
                  "nl": "A"
                }
              },
              {
                "id": "b",
                "title": {
                  "en": "B",
                  "nl": "B"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Powered Up Hub",
        "nl": "Powered Up Hub"
      },
      "class": "button",
      "capabilities": [
        "power_port_a",
        "power_port_b",
        "connect",
        "connected"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/poweredup-hub/assets/images/small.png",
        "large": "/drivers/poweredup-hub/assets/images/large.png",
        "xlarge": "/drivers/poweredup-hub/assets/images/xlarge.png"
      },
      "id": "poweredup-hub"
    }
  ],
  "capabilities": {
    "connect": {
      "type": "boolean",
      "title": {
        "en": "Connect"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "button",
      "uiQuickAction": true
    },
    "connected": {
      "type": "boolean",
      "title": {
        "en": "Connected",
        "nl": "Verbonden"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "power_port_a": {
      "type": "enum",
      "title": {
        "en": "Power Port A"
      },
      "uiComponent": "ternary",
      "getable": true,
      "setable": true,
      "values": [
        {
          "id": "up",
          "title": {
            "en": "Up",
            "nl": "Omhoog"
          }
        },
        {
          "id": "break",
          "title": {
            "en": "Break",
            "nl": "Pauze"
          }
        },
        {
          "id": "down",
          "title": {
            "en": "Down",
            "nl": "Omlaag"
          }
        }
      ]
    },
    "power_port_b": {
      "type": "enum",
      "title": {
        "en": "Power Port B"
      },
      "uiComponent": "ternary",
      "getable": true,
      "setable": true,
      "values": [
        {
          "id": "up",
          "title": {
            "en": "Up",
            "nl": "Omhoog"
          }
        },
        {
          "id": "break",
          "title": {
            "en": "Break",
            "nl": "Pauze"
          }
        },
        {
          "id": "down",
          "title": {
            "en": "Down",
            "nl": "Omlaag"
          }
        }
      ]
    }
  }
}