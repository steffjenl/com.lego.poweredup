        {
          "type": "dropdown",
          "name": "port",
          "title": {
            "en": "Port",
            "nl": "Poort"
          },
          "values": [
            {
              "id": "a",
              "title": {
                "en": "A",
                "nl": "A"
              }
            },
            {
              "id": "b",
              "title": {
